{
  "name": "daymatch",
  "version": "1.0.0",
  "description": "DayMatch - 단기 알바 매칭 플랫폼 (Monorepo)",
  "private": true,
  "workspaces": [
    "backend",
    "admin",
    "mobile"
  ],
  "scripts": {
    "prepare": "husky install",
    "lint": "npm run lint:backend && npm run lint:admin",
    "lint:backend": "cd backend && npm run lint",
    "lint:admin": "cd admin && npm run lint",
    "build": "npm run build:backend && npm run build:admin",
    "build:backend": "cd backend && npm run build",
    "build:admin": "cd admin && npm run build",
    "test": "npm run test:backend",
    "test:backend": "cd backend && npm test",
    "typecheck": "npm run typecheck:backend && npm run typecheck:admin && npm run typecheck:mobile",
    "typecheck:backend": "cd backend && npx tsc --noEmit",
    "typecheck:admin": "cd admin && npx tsc --noEmit",
    "typecheck:mobile": "cd mobile && npx tsc --noEmit",
    "preflight": "./scripts/preflight-check.sh",
    "verify": "npm run typecheck && npm run lint && npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
